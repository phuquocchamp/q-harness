# .env.e2e: keep ONLY 1Password references here, never literal secrets.
# Run tests with:  op run --env-file=.env.e2e -- npx playwright test
# Use a dedicated least-privilege test user per role, on non-production only.
E2E_USER_EMAIL=op://Test/app-e2e/username
E2E_USER_PASSWORD=op://Test/app-e2e/password
# Only if MFA cannot be bypassed in test:
# Reference the base32 secret itself (a plain field), not the live one-time code.
# E2E_TOTP_SECRET=op://Test/app-e2e/totp-secret
# Not secret:
E2E_BASE_URL=http://localhost:3000
